(
    waves: [
        // 0:00 ~ 1:00 — 초보 zombie + 가끔 bat
        (
            start_time: 0.0,
            end_time:   60.0,
            spawn_interval: 1.2,
            enemies: [
                (kind: "Zombie", weight: 6),
                (kind: "Bat",    weight: 2),
            ],
        ),
        // 1:00 ~ 3:00 — skeleton + ghost 추가
        (
            start_time: 60.0,
            end_time:   180.0,
            spawn_interval: 1.0,
            enemies: [
                (kind: "Zombie",   weight: 4),
                (kind: "Bat",      weight: 3),
                (kind: "Skeleton", weight: 2),
                (kind: "Ghost",    weight: 2),
            ],
        ),
        // 3:00 ~ 6:00 — mage / mantis 추가
        (
            start_time: 180.0,
            end_time:   360.0,
            spawn_interval: 0.8,
            enemies: [
                (kind: "Zombie",   weight: 3),
                (kind: "Bat",      weight: 3),
                (kind: "Skeleton", weight: 3),
                (kind: "Ghost",    weight: 2),
                (kind: "Mage",     weight: 2),
                (kind: "Mantis",   weight: 1),
            ],
        ),
        // 6:00 ~ 12:00 — slime / plant 추가
        (
            start_time: 360.0,
            end_time:   720.0,
            spawn_interval: 0.6,
            enemies: [
                (kind: "Skeleton", weight: 2),
                (kind: "Ghost",    weight: 2),
                (kind: "Mage",     weight: 2),
                (kind: "Mantis",   weight: 2),
                (kind: "Slime",    weight: 2),
                (kind: "Plant",    weight: 1),
            ],
        ),
        // 12:00 ~ 20:00 — mummy 등장 (단단한 적)
        (
            start_time: 720.0,
            end_time:   1200.0,
            spawn_interval: 0.5,
            enemies: [
                (kind: "Mage",   weight: 2),
                (kind: "Mantis", weight: 2),
                (kind: "Slime",  weight: 3),
                (kind: "Plant",  weight: 2),
                (kind: "Mummy",  weight: 2),
            ],
        ),
        // 20:00 ~ 30:00 — knight (최강 일반 적)
        (
            start_time: 1200.0,
            end_time:   1800.0,
            spawn_interval: 0.4,
            enemies: [
                (kind: "Mantis", weight: 2),
                (kind: "Slime",  weight: 2),
                (kind: "Mummy",  weight: 3),
                (kind: "Knight", weight: 3),
            ],
        ),
    ],
)
